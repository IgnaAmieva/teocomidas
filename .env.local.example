NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Server-side (nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Mercado Pago
MP_ACCESS_TOKEN=TEST-tu-access-token-aqui

# Webhook secret de MP (Tus integraciones > Webhooks > Secret key)
# Requerido en producción para verificar la firma de las notificaciones
MP_WEBHOOK_SECRET=tu-webhook-secret-aqui

# URL de la app (para callbacks de MP y webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
